# ─── Monad Blockchain ─────────────────────────────────────────────
# JSON-RPC endpoint for Monad mainnet (chain ID 143)
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
# Monad mainnet chain ID
NEXT_PUBLIC_MONAD_CHAIN_ID=143
# Perpl Exchange (CLOB) core contract on Monad
NEXT_PUBLIC_PERPL_EXCHANGE_ADDRESS=0x34B6552d57a35a1D042CcAe1951BD1C370112a6F
# Monad block explorer base URL (tx + address links)
NEXT_PUBLIC_EXPLORER_URL=https://monadexplorer.com

# ─── Perpl API ────────────────────────────────────────────────────
# Perpl public REST API base URL
NEXT_PUBLIC_PERPL_API_URL=https://app.perpl.xyz/api
# Perpl market-data WebSocket endpoint
NEXT_PUBLIC_PERPL_WS_URL=wss://app.perpl.xyz/ws/v1/market-data

# ─── Supabase ─────────────────────────────────────────────────────
# Supabase project URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# Supabase anon/public key (safe for browser, RLS-scoped)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabase service role key (SERVER ONLY — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
